# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/taban

# JWT signing/verification secret (use a long random value)
SECRET_KEY="ggkrglejvxvxv9kj4###C#$$#vccivlv"

# HTTP server port (optional, defaults to 8000)
