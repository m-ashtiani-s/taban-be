# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://taban-fe.liara.run,https://memaryab.com,https://rasmiyab.com,https://admin.rasmiyab.com

# Kavenegar SMS panel
KAVENEGAR_API_KEY=7465796477326A4B5668592B544849416545306145774E4F392F384D37512B5A5177347543445A6E5847553D
KAVENEGAR_TEMPLATE=otptest
PUPPETEER_SKIP_DOWNLOAD="true"

# ZarinPal payment gateway
# merchant_id از پنل زرین‌پال؛ در حالت sandbox می‌توان از یک UUID دلخواه استفاده کرد.
ZARINPAL_MERCHANT_ID=2fb24dff-a19e-4b3e-a560-1c8b890b8d64

# true = درگاه تستی sandbox، false = درگاه واقعی
ZARINPAL_SANDBOX=false
# واحد مبلغ ارسالی به درگاه: IRR (ریال) یا IRT (تومان). قیمت‌های سیستم تومان است.
ZARINPAL_CURRENCY=IRR
# آدرس پایه‌ی بکند برای ساخت callback_url (بدون اسلش انتهایی)
PAYMENT_CALLBACK_BASE=http://localhost:8000
# صفحه‌ی نتیجه‌ی پرداخت در فرانت
PAYMENT_FRONTEND_RESULT=https://rasmiyab.com/payment/result

