# Chromium همراهِ puppeteer را موقع نصب دانلود نکن.
# دلیل: دانلود از storage.googleapis.com در برخی شبکه‌ها/سرورها مسدود است (۴۰۳).
# در زمان اجرا، pdf.util.ts به‌صورت خودکار سراغ Chrome/Edge نصب‌شده‌ی سیستم می‌رود
# (یا متغیر محیطی PUPPETEER_EXECUTABLE_PATH اگر تنظیم شده باشد).
puppeteer_skip_download=true
